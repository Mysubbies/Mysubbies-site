# Copy the variable NAMES below into Vercel Project Settings > Environment
# Variables. Never fill in real values here or commit this file with real
# secrets — it exists purely as documentation of what's needed.

# Stripe (Developers > API keys). Note: contractor payouts require Connect,
# which needs its OWN Stripe account — Stripe does not allow enabling
# Connect on an account already used for something else (e.g. Xero-linked
# invoicing). If deposits and payouts run through different Stripe
# accounts, STRIPE_SECRET_KEY must be the account that actually charges
# customers.
STRIPE_SECRET_KEY=

# Two SEPARATE webhook destinations are required (Stripe doesn't allow
# mixing scopes in one destination — see api/stripe-webhook.js):
#   1. Scope "Your account": payment_intent.succeeded, payment_intent.payment_failed
#   2. Scope "Connected accounts": account.updated
# Each has its own signing secret from Stripe. The webhook handler tries
# both automatically, so both must be set for everything to verify.
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_CONNECT=

# Supabase (Project Settings > API — use the service_role key, not anon,
# since these functions run server-side only and are the sole authority
# over payment state)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Generate any long random string yourself (e.g. `openssl rand -hex 32`).
# Set the SAME value in Vercel's Cron settings for this project so
# weekly-payout.js can verify a request really came from Vercel Cron and
# not a public hit on the URL.
CRON_SECRET=

# Anthropic (console.anthropic.com > API keys). Powers the "Fix Something"
# photo/description triage in api/classify-job.js. Optional: until this is
# set, that feature safely falls back to "Manual Review Required" for every
# request instead of guessing — it is not required for the rest of the site
# to work.
ANTHROPIC_API_KEY=
